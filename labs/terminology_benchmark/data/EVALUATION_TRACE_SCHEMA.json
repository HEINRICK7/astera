{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niede.invalid/clinical-evaluation-trace/v1",
  "title": "ClinicalEvaluationTrace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_schema",
    "evaluation_id",
    "case_id",
    "corpus_version",
    "corpus_checksum",
    "resolver_version",
    "resolver_checksum",
    "policy_version",
    "stage_order",
    "snapshots",
    "decisions",
    "mismatches"
  ],
  "properties": {
    "trace_schema": {"const": "clinical-evaluation-trace/v1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "corpus_version": {"type": "string", "minLength": 1},
    "corpus_checksum": {"type": "string", "minLength": 1},
    "resolver_version": {"type": "string", "minLength": 1},
    "resolver_checksum": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "stage_order": {
      "type": "array",
      "prefixItems": [
        {"const": "input_segments"},
        {"const": "local_mentions"},
        {"const": "semantic_candidates"},
        {"const": "reference_resolution"},
        {"const": "ownership_resolution"},
        {"const": "cross_segment_state"},
        {"const": "resolved_semantics"},
        {"const": "generated_relations"},
        {"const": "final_projection"},
        {"const": "prediction"},
        {"const": "gold"},
        {"const": "comparison"}
      ],
      "minItems": 12,
      "maxItems": 12
    },
    "snapshots": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/snapshot"}
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "mismatches": {
      "type": "array",
      "items": {"$ref": "#/$defs/mismatch"}
    }
  },
  "$defs": {
    "stage": {
      "type": "string",
      "enum": [
        "input_segments",
        "local_mentions",
        "semantic_candidates",
        "reference_resolution",
        "ownership_resolution",
        "cross_segment_state",
        "resolved_semantics",
        "generated_relations",
        "final_projection",
        "prediction",
        "gold",
        "comparison"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "input_hash",
        "output_hash",
        "chain_hash",
        "payload",
        "decisions",
        "preserved_fields",
        "changed_fields",
        "dropped_fields",
        "provenance"
      ],
      "properties": {
        "stage": {"$ref": "#/$defs/stage"},
        "input_hash": {"type": ["string", "null"]},
        "output_hash": {"type": "string", "minLength": 1},
        "chain_hash": {"type": ["string", "null"]},
        "payload": {},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
        "preserved_fields": {"type": "array", "items": {"type": "string"}},
        "changed_fields": {"type": "array", "items": {"type": "string"}},
        "dropped_fields": {"type": "array", "items": {"type": "string"}},
        "provenance": {"type": "object"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "stage", "description", "policy_rules", "input_hash", "output_hash", "provenance"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "stage": {"$ref": "#/$defs/stage"},
        "description": {"type": "string"},
        "policy_rules": {"type": "array", "items": {"type": "string"}},
        "input_hash": {"type": ["string", "null"]},
        "output_hash": {"type": ["string", "null"]},
        "provenance": {"type": "object"}
      }
    },
    "mismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_dimension", "expected", "actual", "stage", "confidence", "policy_rules", "details"],
      "properties": {
        "semantic_dimension": {"type": "string", "minLength": 1},
        "expected": {},
        "actual": {},
        "stage": {"$ref": "#/$defs/stage"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "policy_rules": {"type": "array", "items": {"type": "string"}},
        "details": {"type": "object"}
      }
    }
  }
}
