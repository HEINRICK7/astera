# Copy to .env and fill the credential locally. Never commit .env.
NGC_API_KEY=

# NVIDIA Speech NIM image and profile.
PARAKEET_CONTAINER_ID=parakeet-1-1b-ctc-en-us
NIM_TAGS_SELECTOR=name=parakeet-1-1b-ctc-en-us,mode=all

# Lab endpoints. The HTTP and WebSocket APIs share port 9000.
PARAKEET_HTTP_URL=http://localhost:9000
PARAKEET_WS_URL=ws://localhost:9000/v1/realtime?intent=transcription
PARAKEET_GRPC_PORT=50051

# Use the language supported by the selected NIM image. Do not infer language
# support from this file; verify it in /v1/models and the official model page.
PARAKEET_LANGUAGE=en-US
PARAKEET_MODEL=
PARAKEET_TIMEOUT_SECONDS=60
